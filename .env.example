# AIJajan configuration — copy to .env and edit.
# With the defaults below the app runs fully in MOCK mode (no accounts needed).

# PayPal sandbox app credentials (https://developer.paypal.com -> Sandbox app).
# Leave empty (or set PAYPAL_MOCK=1) to simulate PayPal entirely.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 1 = simulate PayPal even if credentials are present.
PAYPAL_MOCK=1
# Sandbox email that receives Jaja's purchase payouts (default below is a
# placeholder; use a sandbox account email to watch funds land there).
PAYPAL_PAYOUT_RECEIVER=merchants@aijajan.example

# Google Gemini API key (optional). Empty = deterministic built-in planner.
GEMINI_API_KEY=

# Port for the web server.
PORT=3000
